import java.io.*;
import java.util.*;
public class Solution {
    public static void main(String[] args) {
        Scanner sc = new Scanner (System.in);
        int a = sc.nextInt();
        if (a%400 == 0 || (a%4==0 && a%100 != 0)){
            System.out.print(a);
        }else{
            for(int i =a; ; i++){
                if (i%400 == 0 || (i%4==0 && i%100 != 0)){
                    System.out.print(i);
                    break;
                }
            }
        }
    }
}
