import java.io.*;
import java.util.*;

public class Solution {

    public static void main(String[] args) {
        Scanner sc = new Scanner (System.in);
        int a = sc.nextInt();
        int arr[] = new int [a];
        
        for ( int i =0; i < a; i++){
            arr[i] = sc.nextInt();
        }
        
        int largest = 0;
        int sec =0;
        int sum =0;
        for ( int i =0; i < a; i++){
            if (arr[i] > largest){
                sec = largest;
                largest = arr[i];
            }else if (arr[i]> sec && arr[i] != largest){
                sec = arr[i];
            }
        }
        for ( int j =0; j<a; j++){
                if ( arr[j] == sec){
                    sum++;
                }
            }
            System.out.print (sum);
    }
}

