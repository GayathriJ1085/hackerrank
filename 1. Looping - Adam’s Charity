import java.io.*;
import java.util.*;

public class Solution {

    public static void main(String[] args) {
        Scanner sc = new Scanner ( System.in);
        int a = sc.nextInt();
        int count =0;
        
        for ( int i =0; i <=a; i++){
            int b = i*i; 
            count = count + b;
        }
        System.out.print(count);
    }
}
