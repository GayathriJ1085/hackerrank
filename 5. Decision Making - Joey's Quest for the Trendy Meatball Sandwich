import java.io.*;
import java.util.*;

public class Solution {

    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int a = sc.nextInt();
        
        if (a >= 100 && a <= 999){
            int reminder = a/10;
            int b = reminder%10;
            if (b%3==0){
                System.out.print("Trendy Number");
            }
            else{
                System.out.print("Not a Trendy Number");
            }
        }
        else{
            System.out.print("Invalid Number");
        }
    }
}
